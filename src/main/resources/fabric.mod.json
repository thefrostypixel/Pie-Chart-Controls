{
	"schemaVersion": 1,
	"id": "pie-chart-controls",
    "version": "${version}",
	"name": "Pie Chart Controls",
	"description": "Lets you change how the pie chart is navigated and with which keys.",
	"authors": ["thefrostypixel"],
	"contact": {
		"homepage": "https://modrinth.com/mod/pie-chart-controls",
        "sources": "https://github.com/thefrostypixel/Pie-Chart-Controls",
        "issues": "https://github.com/thefrostypixel/Pie-Chart-Controls/issues?q=is%3Aissue"
	},
	"license": "CC0-1.0",
	"icon": "assets/pie-chart-controls/icon.png",
	"environment": "client",
	"entrypoints": {
        "main": ["pieChartControls.Main"],
        "modmenu": ["pieChartControls.Main"]
	},
    "mixins": [
        "pieChartControls.mixins.json"
    ],
	"depends": {
        "minecraft": "${minecraft.range}",
        "fabricloader": "${fabricLoader.range}",
        "fabric-api": "${fabricApi.range}",
        "frosty-lib": "${frostyLib.range}"
	}
}
